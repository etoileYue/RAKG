e": "cross-pollination",\n        "target_type": "Biological Process",\n        "target_description": "Cross-pollination is the transfer of pollen from one plant to another, enabling genetic mixing.",\n        "relation_description": "Genetic diversity is a result of cross-pollination, which is enabled by bees."\n      },\n      {\n        "relation": "Contributes To",\n        "target_name": "biodiversity",\n        "target_type": "Ecological Concept",\n        "target_description": "Biodiversity refers to the variety of life in an ecosystem, including the diversity of species and genetic variation.",\n        "relation_description": "Genetic diversity contributes to biodiversity by supporting a wide range of plant species."\n      },\n      {\n        "relation": "Supports",\n        "target_name": "ecosystem stability",\n        "target_type": "Ecological Concept",\n        "target_description": "Ecosystem stability refers to the ability of an ecosystem to maintain its structure and function over time.",\n        "relation_description": "Genetic diversity supports ecosystem stability by maintaining a diverse range of plant species."\n      }\n    ]\n  }\n}' additional_kwargs={'parsed': None, 'refusal': None} response_metadata={'token_usage': {'completion_tokens': 446, 'prompt_tokens': 933, 'total_tokens': 1379, 'completion_tokens_details': {'accepted_prediction_tokens': None, 'audio_tokens': None, 'reasoning_tokens': 0, 'rejected_prediction_tokens': None}, 'prompt_tokens_details': {'audio_tokens': None, 'cached_tokens': 64}, 'prompt_cache_hit_tokens': 64, 'prompt_cache_miss_tokens': 869}, 'model_name': 'Qwen/Qwen3-32B', 'system_fingerprint': '', 'finish_reason': 'stop', 'logprobs': None} id='run-5c8c1697-1217-410c-b1bc-bec90ad2fc65-0' usage_metadata={'input_tokens': 933, 'output_tokens': 446, 'total_tokens': 1379, 'input_token_details': {'cache_read': 64}, 'output_token_details': {'reasoning': 0}}
