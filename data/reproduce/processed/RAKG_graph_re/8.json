"{\n  \"entities\": [\n    {\n      \"name\": \"Space Exploration\",\n      \"type\": \"Field of Study\",\n      \"description\": \"Space exploration is a field that involves the discovery and investigation of celestial bodies and phenomena in outer space, including the development of technologies and international cooperation to achieve these goals.\",\n      \"attributes\": {\n        \"Historical Start\": \"Mid-20th century\",\n        \"Significant Event - Space Race\": \"1957-1969\",\n        \"First Artificial Satellite\": \"Sputnik 1, 1957\",\n        \"First Human in Orbit\": \"Yuri Gagarin, 1961\",\n        \"First Humans on the Moon\": \"Neil Armstrong and Buzz Aldrin, 1969\",\n        \"Current Focus\": \"International cooperation, commercial ventures, and scientific discoveries\",\n        \"Future Prospects\": \"Further exploration of the solar system, search for habitable exoplanets, and potential new discoveries\",\n        \"Technological Advancements\": \"Reusable rockets, ion propulsion systems, advanced materials\",\n        \"Commercial Involvement\": \"SpaceX, Blue Origin, Virgin Galactic\",\n        \"Public Interest\": \"High, especially in Mars exploration and space tourism\"\n      }\n    },\n    {\n      \"name\": \"Neil Armstrong\",\n      \"type\": \"Person\",\n      \"description\": \"Neil Armstrong was an American astronaut and the first person to walk on the moon as part of the Apollo 11 mission in 1969.\",\n      \"attributes\": {\n        \"Nationality\": \"American\",\n        \"Occupation\": \"Astronaut\",\n        \"Historical Significance\": \"First person to walk on the moon\"\n      }\n    },\n    {\n      \"name\": \"Buzz Aldrin\",\n      \"type\": \"Person\",\n      \"description\": \"Buzz Aldrin is a former NASA astronaut and the second person to walk on the Moon as part of the Apollo 11 mission in 1969.\",\n      \"attributes\": {\n        \"Occupation\": \"Astronaut\",\n        \"Nationality\": \"American\"\n      }\n    }