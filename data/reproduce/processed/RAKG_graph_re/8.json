ributes\": {}\n    },\n    {\n      \"name\": \"NASA\",\n      \"type\": \"Space Agency\",\n      \"description\": \"NASA (National Aeronautics and Space Administration) is the United States\\\" space agency, responsible for the civilian space program and for aeronautics and aerospace research.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"SpaceX\",\n      \"type\": \"Private Company\",\n      \"description\": \"SpaceX (Space Exploration Technologies Corp.) is a private American aerospace manufacturer and space transport services company founded by Elon Musk.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Blue Origin\",\n      \"type\": \"Private Company\",\n      \"description\": \"Blue Origin is an American aerospace manufacturer and spaceflight services company founded by Jeff Bezos, focusing on space tourism and future space exploration.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Virgin Galactic\",\n      \"type\": \"Private Company\",\n      \"description\": \"Virgin Galactic is a British-American spaceflight company founded by Richard Branson, aiming to provide suborbital spaceflights to tourists.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Mars Exploration\",\n      \"type\": \"Space Mission\",\n      \"description\": \"Mars exploration involves missions to study the planet Mars, including the search for signs of past life and the potential for human habitation.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Search for Habitable Exoplanets\",\n      \"type\": \"Space Mission\",\n      \"description\": \"The search for habitable exoplanets involves missions to find planets outside our solar system that could support life.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Outer Planets Exploration\",\n      \"type\": \"Space Mission\",\n      \"description\": \"Exploration of the outer planets involves missions to study planets such as Jupiter and Saturn, including their moons and environments.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Space Tourism\",\n      \"type\": \"Commercial Activity\",\n      \"description\": \"Space tourism is a commercial activity that involves private individuals paying to travel to space, typically on suborbital flights.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Apollo 11 Mission\",\n      \"type\": \"Space Mission\",\n      \"description\": \"The Apollo 11 mission was the first crewed mission to land on the moon, launched by NASA in 1969.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Moon\",\n      \"type\": \"Celestial Body\",\n      \"description\": \"The Moon is Earth\\\"s only natural satellite and the fifth largest moon in the Solar System.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Multiple Countries and Private Companies\",\n      \"type\": \"Organizations\",\n      \"description\": \"Various national space agencies and private aerospace companies are involved in the development and launch of space missions, including Mars rovers.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Mars\",\n      \"type\": \"Planet\",\n      \"description\": \"Mars is the fourth planet from the Sun and the second-smallest planet in the Solar System, after Mercury. It is often referred to as the \\\"Red Planet\\\" due to its reddish appearance, which is caused by iron oxide or rust on its surface.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Voyager missions\",\n      \"type\": \"Space Mission\",\n      \"description\": \"The Voyager missions are a series of space missions launched by NASA in 1977 to study the outer Solar System. The two spacecraft, Voyager 1 and Voyager 2, have provided extensive data on the gas giants and their moons.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Astronauts from different countries\",\n      \"type\": \"Astronauts\",\n      \"description\": \"Astronauts from various countries who live and work together on the ISS, contributing to international cooperation in space exploration.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Space Technology\",\n      \"type\": \"Technology\",\n      \"description\": \"Space technology encompasses the tools, methods, and systems used to explore space, including spacecraft, satellites, and propulsion systems.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Innovation\",\n      \"type\": \"Concept\",\n      \"description\": \"Innovation in space exploration leads to the development of new technologies and methods that can have applications both in space and on Earth.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"NASA\\\"s Perseverance rover\",\n      \"type\": \"Spacecraft\",\n      \"description\": \"NASA\\\"s Perseverance rover is a robotic vehicle that landed on Mars in February 2021. It is equipped with instruments to search for signs of past life on the red planet.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Future Space Missions\",\n      \"type\": \"Space Exploration\",\n      \"description\": \"Future space missions are planned explorations that aim to expand human knowledge and capabilities in space, including the search for habitable exoplanets and signs of extraterrestrial life.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Jupiter\",\n      \"type\": \"Planet\",\n      \"description\": \"Jupiter is the fifth planet from the Sun and the largest in the solar system. It is a gas giant with a prominent system of moons.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Saturn\",\n      \"type\": \"Planet\",\n      \"description\": \"Saturn is the sixth planet from the Sun and is known for its extensive ring system. It is also a gas giant and has numerous moons.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Space Missions\",\n      \"type\": \"Space Exploratio