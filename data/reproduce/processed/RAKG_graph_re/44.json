"{\n  \"entities\": [\n    {\n      \"name\": \"Electricity\",\n      \"type\": \"Energy Source\",\n      \"description\": \"Electricity is one of the most significant discoveries in human history, and its impact on the world cannot be overstated. It has revolutionized the way we live, work, and interact with the world around us.\",\n      \"attributes\": {\n        \"Impact\": \"Transformative and profound\",\n        \"Role\": \"Modernizing society\",\n        \"Historical Significance\": \"One of the most significant discoveries in human history\"\n      }\n    },\n    {\n      \"name\": \"society\",\n      \"type\": \"Social System\",\n      \"description\": \"Society refers to a group of individuals involved in persistent social interaction, or a large social group sharing the same geographical or social territory, typically subject to the same political authority and dominant cultural expectations.\",\n      \"attributes\": {\n        \"Modernization\": \"Electricity has played a crucial role in modernizing society.\",\n        \"Impact on Well-being\": \"Advancements in medical technology powered by electricity have improved overall well-being in society.\"\n      }\n    },\n    {\n      \"name\": \"cooking meals\",\n      \"type\": \"Activity\",\n      \"description\": \"Cooking meals is the process of preparing food for consumption, traditionally involving the use of heat.\",\n      \"attributes\": {\n        \"Historical Method\": \"manual labor\"\n      }\n    },\n    {\n      \"name\": \"electricity\",\n      \"type\": \"Energy Source\",\n      \"description\": \"Electricity is a form of energy that has revolutionized the world, improving public health and safety, enabling innovations in various fields, and facilitating the shift towards sustainable energy sources.\",\n      \"attributes\": {\n        \"Impact on Public Health and Safety\": \"Improved\",\n        \"Impact on Production Efficiency\": \"Increased\",\n        \"Impact on Output\": \"Increased\",\n        \"Impact on Greenhouse Gas Emissions\": \"Reduced\",\n        \"Impact on Sustainable Energy\": \"Facilitated\"\n      }\n    },\n    {\n      \"name\": \"Stoves\",\n      \"type\": \"Appliance\",\n      \"description\": \"Stoves are electric appliances used for cooking meals, which have significantly reduced the reliance on manual labor and contributed to a higher standard of living.\",\n      \"attributes\": {\n        \"Type\": \"Electric Appliance\",\n        \"Function\": \"Cooking Meals\"\n      }\n    },\n    {\n      \"name\": \"healthcare\",\n      \"type\": \"Sector\",\n      \"description\": \"Healthcare is a sector that encompasses the prevention, treatment, and management of illness and the preservation of mental and physical well-being through the services offered by medical, nursing, and allied health professionals.\",\n      \"attributes\": {\n        \"Impact\": \"Saving countless lives and improving overall well-being\",\n        \"Dependency\": \"Electricity\"\n      }\n    },\n    {\n      \"name\": \"Telegraph\",\n      \"type\": \"Invention\",\n      \"description\": \"The telegraph is a device for long-distance communication that uses electrical signals to transmit messages over wires.\",\n      \"attributes\": {\n        \"Invention Date\": \"19th Century\",\n        \"Purpose\": \"Long-distance Communication\",\n        \"Technology\": \"Electrical Signals\"\n      }\n    },\n    {\n      \"name\": \"computers\",\n      \"type\": \"Technology\",\n      \"description\": \"Computers are electronic devices that manipulate information or data. They have the ability to store, retrieve, and process data, and are used in various fields including work, education, and entertainment.\",\n      \"attributes\": {\n        \"Type\": \"Electronic Device\",\n        \"Function\": \"Store, retrieve, and process data\"\n      }\n    },\n    {\n      \"name\": \"Modern Technology\",\n      \"type\": \"Technology\",\n      \"description\": \"Modern technology encompasses a wide range of tools and inventions that have been developed to improve and simplify human life, including computers, electronic devices, and medical equipment.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Global Trade and Communication\",\n      \"type\": \"Economic and Social Activity\",\n      \"description\": \"Global trade and communication involve the exchange of goods, services, and information across international borders, connecting people and markets worldwide.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Communication\",\n      \"type\": \"Social Activity\",\n      \"description\": \"Communication is the exchange of information between individuals through speaking, writing, or using some other medium.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Transportation\",\n      \"type\": \"Industry\",\n      \"description\": \"Transportation involves the movement of people and goods from one place to another.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Industrialization\",\n      \"type\": \"Economic Process\",\n      \"description\": \"Industrialization is the process of transforming a society from a primarily agrarian economy to one based on manufacturing and industry.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Public Health and Safety\",\n      \"type\": \"Social Welfare\",\n      \"description\": \"Public health and safety encompass measures and practices that protect and improve the health and safety of the general population.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Nighttime Operations in Cities\",\n      \"type\": \"Urban Activity\",\n      \"description\": \"Nighttime operations in cities include various activities and services that function during the night, such as businesses, public transport, and emergency services.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Medical Technology\",\n      \"type\": \"Healthcare Equipment\",\n      \"description\": \"Medical technology includes devices, equipment, and procedures used in the healthcare industry to diagnose, treat, and prevent diseases.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Household Appliances\",\n      \"type\": \"Consumer Goods\",\n      \"description\": \"Household appliances are devices used in homes to perform domestic tasks, such as washing machines, refrigerators, and stoves.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Heating and Cooling Systems\",\n      \"type\": \"Building Systems\",\n      \"description\": \"Heating and cooling systems are used to regulate indoor temperatures, ensuring comfort and safety in homes and buildings.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Daily Life\",\n      \"type\": \"Lifestyle\",\n      \"description\": \"Daily life refers to the routine activities and experiences of individuals in their everyday existence.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"Economic Growth\",\n      \"type\": \"Economic Outcome\",\n      \"description\": \"Economic growth is the increase in the capacity of an economy to produce goods and services, compared from one period of time to another.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"telecommunications\",\n      \"type\": \"Communication Technology\",\n      \"description\": \"Telecommunications is the transmission of information by various types of technologies over wire, radio, optical, or other electromagnetic systems.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"transportation\",\n      \"type\": \"Transportation Technology\",\n      \"description\": \"Transportation technology encompasses the methods, materials, and devices used to move people and goods from one place to another.\",\n      \"attributes\": {}\n    },\n    {\n      \"name\": \"computing\",\n      \"type\": \"Information Technology\",\n      \"